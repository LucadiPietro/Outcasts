%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4b4ae4e47a3e1142abb0821ebec2533, type: 3}
  m_Name: ThroneRoom_00
  m_EditorClassIdentifier: 
  m_Lines:
  - m_Speaker: {fileID: 11400000, guid: 7551238c016f5e241acd2247aa07105d, type: 2}
    m_Emotion: 0
    m_Text: Like taking candy from a templar.
  - m_Speaker: {fileID: 11400000, guid: 7551238c016f5e241acd2247aa07105d, type: 2}
    m_Emotion: 0
    m_Text: "I\u2019m pretty good."
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: As I live and breathe... Malphayt Witherwachs and his Outcasts, in the
      flesh.
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: Not one more step fiends!
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: Scum like you should not even dare to approach this hallowed hall!
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: I am the Inquisitor Santiago Martorelli.
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: "The Heretic\u2019s Maul!"
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: Venom of the venomous!
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: Silver Hand of the Law!
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: "I alone am heir to the Dragon\u2019s Claw!"
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 2
    m_Text: The simple thought of you alighting with a sacred artefact is, itself,
      an impure act.
  - m_Speaker: {fileID: 11400000, guid: 7551238c016f5e241acd2247aa07105d, type: 2}
    m_Emotion: 0
    m_Text: "Make it quick Santiago, it\u2019s three against one, this time it\u2019s
      over for you!"
  - m_Speaker: {fileID: 0}
    m_Emotion: 0
    m_Text: Time Ouuuuuuuuuuuuuuut!
  - m_Speaker: {fileID: 11400000, guid: 7551238c016f5e241acd2247aa07105d, type: 2}
    m_Emotion: 0
    m_Text: Goddamn it.
  - m_Speaker: {fileID: 11400000, guid: de9e417a3576df24eb77dce0229abb2b, type: 2}
    m_Emotion: 0
    m_Text: And just as things were heating up too.
  - m_Speaker: {fileID: 11400000, guid: e9bbbac2c63ebed41b7ae91778329c04, type: 2}
    m_Emotion: 0
    m_Text: "Saved by the bell\u2026"
